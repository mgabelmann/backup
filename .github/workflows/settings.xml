<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">

    <servers>
        <server>
            <id>github</id>
            <!-- GitHub PAT to only read packages -->
            <username>${env.GITHUB_ACTOR}</username>
            <password>${env.ACTIONS}</password>
        </server>
    </servers>

    <mirrors>
        <mirror>
            <id>maven-central-fix</id>
            <!-- Match everything EXCEPT your private GitHub Packages repo -->
            <mirrorOf>*,!github</mirrorOf>
            <name>Maven Central</name>
            <url>https://repo.maven.apache.org/maven2</url>
        </mirror>
    </mirrors>

    <profiles>
        <profile>
            <id>github</id>
            <repositories>
                <repository>
                    <id>github</id>
                    <name>Michael Gabelmann GitHub Packages for Maven</name>
                    <url>https://maven.pkg.github.com/mgabelmann/*</url>
                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                </repository>
            </repositories>
        </profile>
    </profiles>

    <activeProfiles>
        <activeProfile>github</activeProfile>
    </activeProfiles>

</settings>
